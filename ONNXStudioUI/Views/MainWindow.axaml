<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ONNXStudioUI.ViewModels"
        xmlns:controls="using:ONNXStudioUI.Controls"
        mc:Ignorable="d"
        x:Class="ONNXStudioUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ONNX Studio"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}"/>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="1*,Auto">

        <!-- Workbench: activity bar | side bar | editor -->
        <Grid Grid.Row="0" x:Name="Workbench" ColumnDefinitions="48,260,Auto,1*">

            <!-- Activity bar -->
            <Border Grid.Column="0" Background="{DynamicResource ActivityBarBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Classes="activity"
                                Classes.active="{Binding IsSettingsActive}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Settings (Ctrl+,)">
                            <PathIcon Data="{StaticResource IconSettings}" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <Button Classes="activity"
                                Classes.active="{Binding IsSidebarVisible}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="Explorer (Ctrl+B)">
                            <PathIcon Data="{StaticResource IconFiles}" Width="22" Height="22"/>
                        </Button>
                        <Button Classes="activity"
                                Classes.active="{Binding IsDashboardActive}"
                                Command="{Binding ShowDashboardCommand}"
                                ToolTip.Tip="Dashboard">
                            <PathIcon Data="{StaticResource IconDashboard}" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Side bar: model explorer -->
            <Border Grid.Column="1"
                    x:Name="SideBar"
                    Background="{DynamicResource SideBarBrush}"
                    IsVisible="{Binding IsSidebarVisible}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="EXPLORER"
                               Classes="section"
                               Margin="20,10,12,6"/>

                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="1*,Auto,Auto"
                          Margin="8,0,6,0"
                          Height="26">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconChevronDown}" Width="14" Height="14"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="MODELS" Classes="section" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon"
                                Command="{Binding OpenModelsCommand}"
                                ToolTip.Tip="Open model... (Ctrl+O)">
                            <PathIcon Data="{StaticResource IconFolderOpen}" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="2" Classes="icon"
                                Command="{Binding ShowDashboardCommand}"
                                ToolTip.Tip="Show dashboard">
                            <PathIcon Data="{StaticResource IconDashboard}" Width="14" Height="14"/>
                        </Button>
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel DockPanel.Dock="Top"
                                IsVisible="{Binding !HasModels}"
                                Margin="20,12,16,0"
                                Spacing="10">
                        <TextBlock Text="No model loaded yet." Classes="body-secondary" TextWrapping="Wrap"/>
                        <Button Classes="primary"
                                Command="{Binding OpenModelsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0">
                            <TextBlock Text="Open model" Foreground="{DynamicResource OnPrimaryBrush}"/>
                        </Button>
                        <TextBlock Text="or drop a .onnx file anywhere in the window" Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TreeView x:Name="ExplorerTree"
                              ItemsSource="{Binding ExplorerNodes}"
                              SelectedItem="{Binding SelectedExplorerNode, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0,2">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:ExplorerNode" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,1*,Auto" MinHeight="22" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Unload model"
                                                      Command="{Binding $parent[TreeView].((vm:MainWindowViewModel)DataContext).UnloadModelCommand}"
                                                      CommandParameter="{Binding Model}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <PathIcon Grid.Column="0"
                                              Data="{Binding Icon, Converter={StaticResource IconKeyConverter}}"
                                              Width="14" Height="14"
                                              Margin="0,0,8,0"
                                              Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Header}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Detail}"
                                               Classes="caption"
                                               VerticalAlignment="Center"
                                               Margin="8,0,8,0"/>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Resizable divider -->
            <GridSplitter Grid.Column="2"
                          x:Name="SideBarSplitter"
                          Width="1"
                          MinWidth="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderSubtleBrush}"
                          IsVisible="{Binding IsSidebarVisible}"/>

            <!-- Editor area -->
            <Grid Grid.Column="3" RowDefinitions="Auto,1*">

                <!-- Tab strip -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TabBarBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Height="36">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditorTab">
                                    <Button Classes="editor-tab"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ActivateTabCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,1" MinWidth="130" MaxWidth="260">
                                            <PathIcon Grid.Column="0"
                                                      Data="{Binding Icon, Converter={StaticResource IconKeyConverter}}"
                                                      Width="14" Height="14"
                                                      Margin="12,0,8,0"
                                                      Foreground="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding $parent[Button].Foreground}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2"
                                                    Classes="icon"
                                                    Margin="8,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Close (Ctrl+W)">
                                                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                            </Button>
                                            <Rectangle Grid.Column="3" Fill="{DynamicResource BorderSubtleBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Current screen -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentViewModel}"
                                ContentTemplate="{StaticResource ViewLocator}" />

                <!-- Toast (notification) overlay -->
                <Border Grid.Row="1"
                        ZIndex="100"
                        IsHitTestVisible="False"
                        IsVisible="{Binding ToastMessage, Converter={StaticResource NullToBoolConverter}}"
                        Background="{DynamicResource SideBarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,10"
                        MaxWidth="420"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        BoxShadow="0 4 16 0 #66000000">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{StaticResource IconBox}" Width="14" Height="14"
                                  Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding ToastMessage}" Classes="body" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <controls:StatusBar Grid.Row="1"
                            Status="{Binding StatusMessage}"
                            Extra="{Binding StatusDetails}"
                            Info="{Binding AppVersion, StringFormat='ONNX Studio v{0}'}"/>
    </Grid>
</Window>
