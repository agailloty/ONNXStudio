<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             xmlns:models="using:ONNXStudio.Core.Models"
             xmlns:controls="using:ONNXStudioUI.Controls"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="toolbar" Padding="12,4">
            <Grid ColumnDefinitions="1*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconDashboard}" Width="14" Height="14"
                              Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Dashboard" Classes="h4"/>
                    <TextBlock Text="&#x203A;" Classes="body-small"/>
                    <TextBlock Text="Loaded models" Classes="body-small"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Classes="primary"
                            Command="{Binding OpenModelsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12"/>
                            <TextBlock Text="Open models" Foreground="{DynamicResource OnPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search + sort -->
        <Border DockPanel.Dock="Top" Padding="20,12,20,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconSearch}"
                          Width="14" Height="14"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBox PlaceholderText="Search models..."
                         Text="{Binding SearchText, Mode=TwoWay}"
                         MinWidth="320"/>
                <TextBlock Text="Sort by" Classes="body-secondary" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                          MinWidth="160"/>
            </StackPanel>
        </Border>

        <!-- Models -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FilteredModels}" Margin="14,8,14,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:OnnxModel">
                        <controls:Card Width="300" Margin="6">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,1*,Auto">
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource SelectionBrush}"
                                            CornerRadius="4"
                                            Height="36" Width="36">
                                        <PathIcon Data="{StaticResource IconBox}"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   Classes="h4"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProducerName}"
                                                   Classes="caption"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="icon"
                                            VerticalAlignment="Top"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).UnloadModelCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Unload model">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14"/>
                                    </Button>
                                </Grid>

                                <!-- Facts -->
                                <WrapPanel>
                                    <Border Classes="panel" Padding="6,2" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding OpsetVersion, StringFormat='opset {0}'}" Classes="code"/>
                                    </Border>
                                    <Border Classes="panel" Padding="6,2" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding FileSizeDisplay}" Classes="code"/>
                                    </Border>
                                    <Border Classes="panel" Padding="6,2" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Graph.Nodes.Count, StringFormat='{}{0} nodes'}" Classes="code"/>
                                    </Border>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="Inspect"
                                            Classes="small primary"
                                            Margin="0"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).InspectModelCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Inference"
                                            Classes="small secondary"
                                            Margin="0"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).RunModelCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="API"
                                            Classes="small secondary"
                                            Margin="0"
                                            Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).ServeModelCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
