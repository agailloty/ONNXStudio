<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ONNXStudio.Mocks"
             xmlns:converters="using:ONNXStudio.Mocks.Converters"
             x:Class="ONNXStudio.Mocks.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Styles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Colors.axaml" />
                <ResourceInclude Source="/Styles/Spacing.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter" />
            <converters:BoolToInverseConverter x:Key="BoolToInverseConverter" />
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:BoolToBorderConverter x:Key="BoolToBorderConverter" />
            <converters:DoubleToPercentConverter x:Key="DoubleToPercentConverter" />
            <converters:StringToBrushConverter x:Key="StringToBrushConverter" />

            <!-- View Locator -->
            <local:ViewLocator x:Key="ViewLocator" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
