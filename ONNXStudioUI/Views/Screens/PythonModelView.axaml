<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             xmlns:controls="using:ONNXStudioUI.Controls"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.PythonModelView"
             x:DataType="vm:PythonModelViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="toolbar" Padding="12,2">
            <Grid ColumnDefinitions="1*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconTerminal}" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding Model.Name}" Classes="h4"/>
                    <TextBlock Text="&#x203A;" Classes="body-small"/>
                    <TextBlock Text="Python model" Classes="body-small"/>
                    <TextBlock Text="{Binding Model.FileSizeDisplay}" Classes="caption" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:Spinner IsVisible="{Binding IsWorking}"/>
                    <Button Content="Cancel" Classes="secondary small"
                            Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding IsWorking}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="16" Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">

                <!-- Runtime -->
                <GroupBox Header="Python runtime">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding RuntimeStatus}" Classes="body" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Python settings..." Classes="secondary small" Command="{Binding OpenPythonSettingsCommand}"/>
                            <Button Content="Check again" Classes="secondary small" Command="{Binding RefreshRuntimeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Load -->
                <GroupBox Header="Model">
                    <StackPanel Spacing="10">
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Classes="body-small" TextWrapping="Wrap"
                                       Text="Loading a joblib or pickle file runs the code it contains. Only load files you created or fully trust."/>
                        </Border>
                        <CheckBox IsChecked="{Binding IsTrusted, Mode=TwoWay}"
                                  Content="I trust this file and allow ONNX Studio to load it with Python"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary"
                                    Command="{Binding LoadCommand}"
                                    IsEnabled="{Binding CanLoad}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14"/>
                                    <TextBlock Text="{Binding LoadButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding LoadError}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding LoadError, Converter={StaticResource NullToBoolConverter}}"/>

                        <StackPanel Spacing="6" IsVisible="{Binding IsLoaded}">
                            <Grid ColumnDefinitions="140,1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Type" Classes="label"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummaryText}" Classes="code" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Input features" Classes="label"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FeaturesText}" Classes="code" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Text="Classes" Classes="label"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClassesText}" Classes="code" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Text="Methods" Classes="label"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MethodsText}" Classes="code" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="4" Text="Library" Classes="label"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VersionText}" Classes="code" TextWrapping="Wrap"/>
                            </Grid>
                            <Expander Header="Parameters">
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" Classes="code" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="body-small" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Inference -->
                <GroupBox Header="Inference" IsVisible="{Binding IsLoaded}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="body-small" TextWrapping="Wrap"
                                   Text="One row per line, values separated by commas, semicolons or tabs. Text models take one text per line."/>
                        <Grid ColumnDefinitions="Auto,200,Auto,1*">
                            <TextBlock Text="Method:" Classes="body" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Methods}"
                                      SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <CheckBox Grid.Column="3" Margin="16,0,0,0"
                                      IsChecked="{Binding HasHeader, Mode=TwoWay}"
                                      Content="First line is a header (column names)"/>
                        </Grid>
                        <TextBox Text="{Binding InputText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 MinHeight="100"
                                 FontFamily="Consolas, Menlo, monospace"
                                 TextWrapping="NoWrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14"/>
                                    <TextBlock Text="Run"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ResultInfo}" Classes="body-small" VerticalAlignment="Center"
                                       IsVisible="{Binding HasResult}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InferenceError}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding InferenceError, Converter={StaticResource NullToBoolConverter}}"/>

                        <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PythonOutputItem">
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Padding="12" Margin="0,4">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" Classes="label"/>
                                                <TextBlock Text="{Binding Header}" Classes="body-small" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" Classes="code" Margin="0,1" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- Conversion -->
                <GroupBox Header="Convert to ONNX" IsVisible="{Binding IsLoaded}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="140,1*,Auto" RowDefinitions="Auto,Auto,Auto" >
                            <TextBlock Text="Output file:" Classes="body" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding OutputPath, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Content="Browse..." Classes="secondary small" Margin="8,0,0,0"
                                    Command="{Binding BrowseOutputCommand}"/>

                            <TextBlock Grid.Row="1" Text="Target opset:" Classes="body" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpsetText, Mode=TwoWay}" Width="100"
                                     HorizontalAlignment="Left" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Text="Input types:" Classes="body" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                     Text="{Binding InputTypesText, Mode=TwoWay}"
                                     PlaceholderText="Optional - name:type[:width], e.g. age:float, city:string (types: float, int64, string)"/>
                        </Grid>
                        <CheckBox IsChecked="{Binding DisableZipMap, Mode=TwoWay}"
                                  Content="Return classifier probabilities as a tensor (disable ZipMap)"/>
                        <CheckBox IsChecked="{Binding ValidateConversion, Mode=TwoWay}"
                                  Content="Validate against scikit-learn on random samples"/>
                        <CheckBox IsChecked="{Binding LoadAfterConversion, Mode=TwoWay}"
                                  Content="Open the ONNX model in ONNX Studio after conversion"/>
                        <Button Classes="primary" HorizontalAlignment="Left"
                                Command="{Binding ConvertCommand}" IsEnabled="{Binding CanConvert}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14"/>
                                <TextBlock Text="Convert"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ConversionError}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ConversionError, Converter={StaticResource NullToBoolConverter}}"/>
                        <StackPanel Spacing="4" IsVisible="{Binding HasConversionResult}">
                            <TextBlock Text="{Binding ConversionSummary}" Classes="label" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding ConversionDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="code" TextWrapping="Wrap" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
