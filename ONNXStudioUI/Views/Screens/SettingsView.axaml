<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="toolbar" Padding="12,2">
            <Grid ColumnDefinitions="Auto,Auto,1*,Auto">
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Settings" Classes="h4"/>
                </StackPanel>
                <Button Grid.Column="3" Classes="primary" Command="{Binding SaveCommand}">
                    <TextBlock Text="Save"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="page-content">
                <StackPanel Spacing="6">
                    <TextBlock Text="Make Studio yours" Classes="h1"/>
                    <TextBlock Text="Choose your appearance, local API and Python environment." Classes="body-secondary"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <GroupBox Header="Appearance">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Theme" Classes="label"/>
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Use a light or dark workspace, or follow your system." Classes="body-small"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="API server">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Port" Classes="label"/>
                            <TextBox Text="{Binding ApiPort, Mode=TwoWay}"
                                     Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Classes="body-small"
                                   Text="Applied on the next server start (API configuration screen of a model)."/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <GroupBox Header="Python runtime (scikit-learn, ONNX conversion)" IsVisible="{Binding Python, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel Spacing="16" DataContext="{Binding Python}" x:DataType="vm:PythonRuntimeViewModel">
                        <TextBlock Classes="body-small" TextWrapping="Wrap"
                                   Text="ONNX Studio ships no Python. To open joblib / pickle models and convert them to ONNX, let it install its own Python and packages in its data folder, or use a Python you already have."/>
                        <TextBlock Text="{Binding Status}" Classes="body" TextWrapping="Wrap"/>

                        <TextBlock Text="Interpreter in use" Classes="label"/>
                        <ComboBox ItemsSource="{Binding Interpreters}"
                                  SelectedItem="{Binding SelectedInterpreter, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsBusy}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PythonInterpreterItem">
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedDetails}" Classes="body-small" TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedDetails, Converter={StaticResource NullToBoolConverter}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Detect again" Classes="secondary small"
                                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>

                        <TextBlock Text="Use an existing Python" Classes="label"/>
                        <Grid ColumnDefinitions="1*,Auto,Auto,Auto">
                            <TextBox Text="{Binding CustomPath, Mode=TwoWay}"
                                     PlaceholderText="python.exe / python3, or the folder of a virtual environment"/>
                            <Button Grid.Column="1" Content="Use" Classes="secondary small" Margin="8,0,0,0"
                                    Command="{Binding UseCustomCommand}" IsEnabled="{Binding !IsBusy}"/>
                            <Button Grid.Column="2" Content="File..." Classes="secondary small" Margin="8,0,0,0"
                                    Command="{Binding BrowseInterpreterCommand}" IsEnabled="{Binding !IsBusy}"/>
                            <Button Grid.Column="3" Content="Folder..." Classes="secondary small" Margin="8,0,0,0"
                                    Command="{Binding BrowseEnvironmentCommand}" IsEnabled="{Binding !IsBusy}"/>
                        </Grid>

                        <TextBlock Text="ONNX Studio runtime" Classes="label"/>
                        <TextBlock Classes="body-small" TextWrapping="Wrap"
                                   Text="Downloads a standalone CPython from github.com/astral-sh/python-build-standalone (checksum verified), then installs numpy, scipy, pandas, scikit-learn, joblib, skl2onnx, onnx and onnxruntime from PyPI. Nothing is installed system-wide."/>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Classes="primary" Command="{Binding InstallPythonCommand}" IsEnabled="{Binding CanInstall}">
                                <TextBlock Text="{Binding InstallPythonLabel}"/>
                            </Button>
                            <Button Classes="secondary" Content="Install / update packages"
                                    Command="{Binding InstallPackagesCommand}" IsEnabled="{Binding CanInstallPackages}"/>
                            <Button Classes="secondary" Content="Remove"
                                    Command="{Binding RemoveManagedCommand}" IsEnabled="{Binding CanRemove}"/>
                            <Button Classes="danger" Content="Cancel"
                                    Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}"/>
                        </WrapPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding ProgressMessage, Converter={StaticResource NullToBoolConverter}}">
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="100"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                            <TextBlock Text="{Binding ProgressMessage}" Classes="body-small" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={StaticResource NullToBoolConverter}}"/>
                        <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 MaxHeight="160" FontFamily="Consolas, Menlo, monospace"
                                 IsVisible="{Binding HasLog}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="About">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Image Source="/Assets/onnxstudio.png" Width="48" Height="48" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion, StringFormat='ONNX Studio v{0}'}" Classes="h3"/>
                            <TextBlock Text="Explore model graphs, run predictions locally and serve models through an API."
                                       Classes="body-secondary"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
