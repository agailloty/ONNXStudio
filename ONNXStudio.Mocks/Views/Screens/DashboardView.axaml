<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ONNXStudio.Mocks.Controls"
             mc:Ignorable="d"
             x:Class="ONNXStudio.Mocks.Views.Screens.DashboardView">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="1*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="ONNX Studio"
                               Classes="h1"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Dashboard"
                               Classes="body-secondary"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="+ Open Model"
                            Classes="primary"
                            Command="{Binding OpenModelCommand}" />
                    <Button Content="Settings"
                            Classes="secondary"
                            Command="{Binding ShowSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Box -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BackgroundBrush}"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox PlaceholderText="Search models..."
                         Text="{Binding SearchText, Mode=TwoWay}"
                         MinWidth="320"
                         HorizontalAlignment="Left" />
                <Button Content="Search"
                        Classes="secondary"
                        Command="{Binding SearchCommand}" />
            </StackPanel>
        </Border>

        <!-- Bulk Actions -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="Select All"
                          IsChecked="{Binding IsSelectAll, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <Button Content="Unload Selected"
                        Classes="secondary"
                        Command="{Binding UnloadSelectedCommand}" />
                <Button Content="Unload All"
                        Classes="danger"
                        Command="{Binding UnloadAllCommand}" />
            </StackPanel>
        </Border>

        <!-- Models Grid -->
        <ScrollViewer >
            <ItemsControl ItemsSource="{Binding FilteredModels}"
                          Margin="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:Card Width="240"
                                      Margin="8">
                            <StackPanel Spacing="8">
                                <!-- Preview/Icon -->
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="6"
                                        Height="64"
                                        Width="64"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewIcon}"
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Model Name -->
                                <TextBlock Text="{Binding Name}"
                                           Classes="h3"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" />

                                <!-- Stats -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding OpsetVersion, StringFormat='Opset: {0}'}"
                                               Classes="body-small" />
                                    <TextBlock Text="&#x00B7;"
                                               Classes="body-small" />
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               Classes="body-small" />
                                    <TextBlock Text="&#x00B7;"
                                               Classes="body-small" />
                                    <TextBlock Text="{Binding LoadedTimeDisplay}"
                                               Classes="body-small" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center">
                                    <Button Content="Inspect"
                                            Classes="small primary"
                                            Command="{Binding $parent[ItemsControl].DataContext.InspectModelCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Infer"
                                            Classes="small secondary"
                                            Command="{Binding $parent[ItemsControl].DataContext.RunInferenceCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="API"
                                            Classes="small secondary"
                                            Command="{Binding $parent[ItemsControl].DataContext.ShowApiConfigCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
