<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.ApiSandboxView"
             x:DataType="vm:ApiSandboxViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,Auto,1*,Auto">
                <Button Grid.Column="0" Classes="secondary" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconChevronLeft}" Width="14" Height="14"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding Model.Name}"
                           Classes="h2"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <Button Content="Inspect"
                            Classes="secondary"
                            Command="{Binding SwitchToInspectorCommand}"/>
                    <Button Content="Inference"
                            Classes="secondary"
                            Command="{Binding SwitchToInferenceCommand}"/>
                    <Button Content="API"
                            Classes="secondary"
                            Command="{Binding SwitchToConfigCommand}"/>
                    <Button Content="Sandbox" Classes="tab-active"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="1*,280" Margin="12">

            <!-- Request + response -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,12" Spacing="8">
                        <ComboBox ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint}" IsEnabled="{Binding !IsSending}"/>
                        <TextBlock Text="{Binding EndpointUrl}" Classes="code"/>
                        <Button Classes="primary"
                                Command="{Binding SendCommand}"
                                IsEnabled="{Binding !IsSending}"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14"/>
                                <TextBlock Text="Send request"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel Margin="16,0,16,16" Spacing="12">
                            <GroupBox Header="Request body" IsVisible="{Binding RequiresBody}" IsEnabled="{Binding !IsSending}">
                                <TextBox Text="{Binding RequestBody, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         FontFamily="{DynamicResource CodeFontFamily}"
                                         FontSize="12"
                                         MinHeight="140"/>
                            </GroupBox>

                            <GroupBox Header="cURL"><TextBox Text="{Binding CurlPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"/></GroupBox>
                            <GroupBox Header="Response"
                                      IsVisible="{Binding HasResponse}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding StatusCode}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding StatusBrush}"/>
                                        <TextBlock Text="{Binding ElapsedMs, StringFormat='{}{0} ms'}" Classes="body-small"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResponseHeaders}" Classes="code" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding ResponseBody, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             FontFamily="{DynamicResource CodeFontFamily}"
                                             FontSize="12"
                                             MinHeight="120"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- History -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0,8,8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="1*,Auto" Margin="16,12">
                        <TextBlock Text="History" Classes="h3"/>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Classes="small secondary"
                                Command="{Binding ClearHistoryCommand}"/>
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding History}" Margin="8,0,8,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,4">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding StatusCode}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding TimeDisplay}" Classes="body-small"/>
                                                <TextBlock Text="{Binding ElapsedMs, StringFormat='{}{0} ms'}" Classes="body-small"/>
                                            </StackPanel>
                                            <Button Content="Re-run"
                                                    Classes="small primary"
                                                    Command="{Binding $parent[ItemsControl].((vm:ApiSandboxViewModel)DataContext).RerunCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
