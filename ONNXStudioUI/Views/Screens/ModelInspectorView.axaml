<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             xmlns:models="using:ONNXStudio.Core.Models"
             xmlns:controls="using:ONNXStudioUI.Controls"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.ModelInspectorView"
             x:DataType="vm:ModelInspectorViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="AttributeTemplate" x:DataType="vm:AttributeEntry">
            <StackPanel Margin="0,4" Spacing="4">
                <TextBlock Text="{Binding Key}" Classes="label" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Value}" Classes="code" TextWrapping="Wrap"/>
                <StackPanel IsVisible="{Binding HasMultiplePages}" Spacing="4">
                    <TextBlock Text="{Binding PageSummary}" Classes="body-small"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Previous" Command="{Binding PreviousPageCommand}" Classes="secondary"/>
                        <Button Content="Next" Command="{Binding NextPageCommand}" Classes="secondary"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.graph-node">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style Selector="Button.graph-node:pointerover">
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="toolbar" Padding="12,2">
            <Grid ColumnDefinitions="Auto,Auto,1*,Auto">
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconBox}" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding Model.Name}" Classes="h4" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Model.Name}"/>
                    <TextBlock Text="&#x203A;" Classes="body-small"/>
                    <TextBlock Text="Inspector" Classes="body-small"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <Button Content="Inspect" Classes="tab-active"/>
                    <Button Content="Inference"
                            Classes="tab"
                            Command="{Binding SwitchToInferenceCommand}"/>
                    <Button Content="API"
                            Classes="tab"
                            Command="{Binding SwitchToApiCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <WrapPanel ItemSpacing="24">
                <ItemsControl ItemsSource="{Binding Facts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="24"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="body-small" TextWrapping="NoWrap" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="body-small" TextWrapping="NoWrap" Text="{Binding Statistics.NodeCount, StringFormat='{}{0} nodes'}"/>
                <TextBlock Classes="body-small" TextWrapping="NoWrap" Text="{Binding Statistics.EdgeCount, StringFormat='{}{0} edges'}"/>
                <TextBlock Classes="body-small" TextWrapping="NoWrap" Text="{Binding Statistics.TotalParameters, StringFormat='{}{0} parameters'}"/>
                <TextBlock Classes="body-small" TextWrapping="NoWrap" Text="{Binding Model.FileSizeDisplay}"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Graph" Command="{Binding ShowGraphViewCommand}"
                        Classes="tab" Classes.tab-active="{Binding ShowGraph}"/>
                <Button Content="Structure &amp; Parameters" Command="{Binding ShowStructureViewCommand}"
                        Classes="tab" Classes.tab-active="{Binding ShowStructure}"/>
            </StackPanel>
        </Border>

        <Grid>
        <!-- Main content -->
        <Grid ColumnDefinitions="1*,320" Margin="12" IsVisible="{Binding ShowGraph}">

            <!-- Graph -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <!-- Search + filter -->
                    <Border DockPanel.Dock="Top" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                                      Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox PlaceholderText="Search nodes..."
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     MinWidth="220"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      MinWidth="140"/>
                        </StackPanel>
                    </Border>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Scroll to zoom · Drag to pan · Click a node to inspect" Margin="12" Classes="body-small"/>
                        <controls:GraphViewer Nodes="{Binding Nodes}" Graph="{Binding Model.Graph}" SelectedNode="{Binding SelectedNode}" SelectNodeCommand="{Binding SelectNodeCommand}" MinHeight="240"/>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Node details -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0,8,8,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" Spacing="12">
                        <TextBlock Text="Node details" Classes="h3"/>

                        <!-- Empty state -->
                        <TextBlock Text="Click on a node to see its details"
                                   Classes="body-secondary"
                                   IsVisible="{Binding !ShowNodeDetails}"
                                   Margin="0,24,0,0"/>

                        <!-- Selected node -->
                        <StackPanel IsVisible="{Binding ShowNodeDetails}" Spacing="12">
                            <TextBlock Text="{Binding SelectedNode.OpType}" Classes="h4" TextWrapping="Wrap"
                                       Foreground="{Binding SelectedNode.CategoryBrush}"/>
                            <TextBlock Text="{Binding SelectedNode.Name}" Classes="code"/>
                            <TextBlock Text="{Binding DependencySummary}" Classes="body-small"/>

                            <GroupBox Header="Attributes">
                                <ItemsControl ItemsSource="{Binding SelectedNodeAttributes}" ItemTemplate="{StaticResource AttributeTemplate}"/>
                            </GroupBox>

                            <GroupBox Header="Inputs">
                                <ItemsControl ItemsSource="{Binding SelectedNodeInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" Classes="code"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="Outputs">
                                <ItemsControl ItemsSource="{Binding SelectedNodeOutputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" Classes="code"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>

                        <!-- Model inputs / outputs / weights -->
                        <GroupBox Header="Model inputs">
                            <ItemsControl ItemsSource="{Binding Model.Inputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TensorSchema">
                                        <WrapPanel ItemSpacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" Classes="code"/>
                                            <TextBlock Text="{Binding Display}" Classes="body-small"/>
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox Header="Model outputs">
                            <ItemsControl ItemsSource="{Binding Model.Outputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TensorSchema">
                                        <WrapPanel ItemSpacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" Classes="code"/>
                                            <TextBlock Text="{Binding Display}" Classes="body-small"/>
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox Header="Initializers">
                            <ItemsControl ItemsSource="{Binding Initializers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:InitializerInfo">
                                        <WrapPanel ItemSpacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" Classes="code"/>
                                            <TextBlock Text="{Binding ShapeDisplay}" Classes="body-small"/>
                                            <TextBlock Text="{Binding ElementCount, StringFormat='{}{0} elements'}" Classes="body-small"/>
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- Structure explorer: the mock's tree and parameter panel, backed by the loaded model. -->
        <Grid ColumnDefinitions="1*,360" Margin="12" IsVisible="{Binding ShowStructure}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
                        <TextBlock Text="Model structure" Classes="h3"/>
                        <TextBlock Text="{Binding StructureSummary}" Classes="body-small" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TreeView x:Name="StructureTree" ItemsSource="{Binding Components}"
                              SelectedItem="{Binding SelectedComponent, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:ModelComponent" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Header}" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Header}"/>
                                    <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource SurfaceElevatedBrush}">
                                        <TextBlock Text="{Binding Kind}" Classes="body-small" TextWrapping="NoWrap"/>
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Margin="8,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" Spacing="12">
                        <TextBlock Text="Parameters" Classes="h3"/>
                        <TextBlock Text="{Binding SelectedComponent.Header}" Classes="h4" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedComponent.Description}" Classes="body-secondary" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding SelectedComponent.Parameters}" ItemTemplate="{StaticResource AttributeTemplate}"/>
                        <GroupBox Header="Learned attributes" IsVisible="{Binding SelectedComponent.HasFitted}">
                            <ItemsControl ItemsSource="{Binding SelectedComponent.Fitted}" ItemTemplate="{StaticResource AttributeTemplate}"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
