<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,Auto,1*,Auto">
                <Button Grid.Column="0" Classes="secondary" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconChevronLeft}" Width="14" Height="14"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="Settings" Classes="h2"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Grid.Column="3" Classes="primary" Command="{Binding SaveCommand}">
                    <TextBlock Text="Save"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

                <GroupBox Header="General">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="200,1*">
                            <TextBlock Grid.Column="0" Text="Theme:" Classes="body" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                      Width="220"
                                      HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="API server">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="200,Auto">
                            <TextBlock Grid.Column="0" Text="Port:" Classes="body" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ApiPort, Mode=TwoWay}"
                                     Width="120"/>
                        </Grid>
                        <TextBlock Classes="body-small"
                                   Text="Applied on the next server start (API configuration screen of a model)."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="About">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding AppVersion, StringFormat='ONNX Studio v{0}'}" Classes="h3"/>
                        <TextBlock Text="Inspect, run and serve your ONNX models - modular monolith built on Avalonia, ONNX Runtime and ASP.NET Core."
                                   Classes="body-secondary"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
