<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ONNXStudioUI.ViewModels.Screens"
             xmlns:controls="using:ONNXStudioUI.Controls"
             mc:Ignorable="d"
             x:Class="ONNXStudioUI.Views.Screens.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="1*,Auto,1*">
            <StackPanel Grid.Column="1"
                        Width="560"
                        VerticalAlignment="Center"
                        Margin="0,64"
                        Spacing="28">

                <!-- Title -->
                <StackPanel Spacing="6">
                    <TextBlock Text="ONNX Studio" FontSize="32" FontWeight="Light"/>
                    <TextBlock Text="Inspect, run and serve your ONNX models"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Start -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Start" Classes="h3"/>
                    <Button Classes="link"
                            Command="{Binding OpenModelCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16"/>
                            <TextBlock Text="Open Model..." Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Ctrl+O" Classes="caption" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <controls:Spinner IsVisible="{Binding IsBusy}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding StatusMessage}" Classes="body-small"/>
                </StackPanel>

                <!-- Drop zone -->
                <Border x:Name="DropZone"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="28">
                    <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="16">
                        <PathIcon Data="{StaticResource IconUpload}"
                                  Width="32" Height="32"
                                  Foreground="{DynamicResource PrimaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Drop your .onnx, .joblib or .pkl file here" Classes="h4" TextWrapping="Wrap"/>
                            <TextBlock Text="Anywhere in the window - several files can be dropped at once. joblib / pickle models need a Python runtime (Settings); once converted they behave like any ONNX model (graph, inference, API)."
                                       Classes="body-small"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Workflow -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Workflow" Classes="h3"/>
                    <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource IconGraph}" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Inspect - browse the computation graph, attributes and initializers" Classes="body-secondary"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource IconPlay}" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Inference - fill a generated form and run the model locally" Classes="body-secondary"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource IconApi}" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="API - serve it over REST and try it in the sandbox" Classes="body-secondary"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource IconTerminal}" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="scikit-learn - explore pipelines, parameters and learned attributes, then convert to ONNX" Classes="body-secondary"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
